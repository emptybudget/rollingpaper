# Upstash Redis (콘솔에서 DB 생성 후 REST URL/TOKEN 복사)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 관리자 페이지(/admin) 비밀번호 — 설정 안 하면 기본값 0710
ADMIN_PASSWORD=

# (선택) 시각 덮어쓰기 — 테스트용
# 기본값: 작성 마감 2026-07-14T00:00:00+09:00(월 자정), 공개 2026-07-14T09:00:00+09:00(화 오전 9시)
# NEXT_PUBLIC_WRITE_CLOSE_AT=2026-07-14T00:00:00+09:00
# NEXT_PUBLIC_RELEASE_AT=2026-07-14T09:00:00+09:00
